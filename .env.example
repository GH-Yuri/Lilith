# Alpaca API credentials (get from https://app.alpaca.markets)
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here
ALPACA_PAPER=true

# AI Model configuration
# OpenAI:  AI_BASE_URL=https://api.openai.com/v1       AI_MODEL=gpt-4o-mini
# Grok:    AI_BASE_URL=https://api.x.ai/v1             AI_MODEL=grok-3
# Claude:  AI_BASE_URL=https://api.anthropic.com/v1     AI_MODEL=claude-sonnet-4-20250514
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3

# Trading configuration
TRADE_SYMBOL=BTC/USD
ANALYSIS_INTERVAL_SECONDS=300
MAX_HOLD_HOURS=18
DAILY_ANALYSIS_HOUR_UTC=8
